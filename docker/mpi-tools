#!/usr/bin/env bash
# List the bioinformatics tools available in this training image.
set -euo pipefail

TSV=/opt/tools.tsv

printf '\n%-16s %-9s %s\n' "COMMAND" "VERSION" "DESCRIPTION"
printf '%-16s %-9s %s\n' "----------------" "---------" "-----------"
while IFS=$'\t' read -r cmd env version description; do
    [ -z "${cmd:-}" ] && continue
    case "$cmd" in \#*) continue ;; esac
    printf '%-16s %-9s %s\n' "$cmd" "$version" "$description"
done < "$TSV"
printf '\nAll tools are on PATH - run them directly, e.g. "spades.py --help".\n'
printf 'No "module load" and no environment activation is needed.\n\n'
